// Shared by every scene shader. Must match FrameData in render/renderer.cpp.
struct FrameData {
  float4x4 view;
  float4x4 viewProj;
  float4 lightDir;   // xyz: direction towards the light
  float4 lightColor; // rgb * intensity
  float4 ambient;
  float4 params;     // x: toon bands (0 = smooth), y: shadows on, z: shadow-map texel size in world units, w: dither amount
  float4 params2;    // x: texel-space lighting on, y: texels per world unit, z: ramp shading on, w: ramp shadow steps
  float4x4 lightViewProj; // world -> shadow map clip space
  float4 pointInfo;        // x: number of point lights
  float4 pointPosition[8]; // xyz: position, w: range
  float4 pointColor[8];    // rgb * intensity
};

// Per-draw constants. Must match DrawData in render/renderer.cpp.
struct DrawData {
  float4x4 model;
  float4x4 normalMatrix;
  float4 color;
  float4 emissive; // rgb: emissive
  float4 flags;    // x: 0 = lit surface, 1 = sprite (lit as a whole from `origin`), y: world-space texel mapping
  float4 origin;   // xyz: sprites: the world point whose light/shadow the whole sprite takes
  float4 uvRect;   // uv = uv * zw + xy (sprite sheet frame, horizontal flip)
};

// 4x4 ordered-dither threshold in 0..1 for an integer coordinate.
float bayer4(int2 p) {
  static const float m[16] = {0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5};
  return (m[(p.x & 3) + (p.y & 3) * 4] + 0.5) / 16.0;
}

// Exact sRGB encoding: the palette lookup needs exact round trips, or close
// colors (light stone vs pale sky) get confused.
float3 linearToSrgb(float3 c) {
  c = saturate(c);
  return select(c <= 0.0031308, c * 12.92, 1.055 * pow(c, 1.0 / 2.4) - 0.055);
}

// Ramp shading: find the palette entry nearest to the surface color, then move
// along its row: towards the darker (usually cooler) end as light falls off,
// one step brighter in full light. Textures are drawn in the ramp's mid-tones.
// `palette` is sRGB-typed (Load returns linear); rows are ramps, darkest on the
// left, transparent texels are gaps. Returns linear color.
float3 rampShade(Texture2D palette, float3 albedoLinear, float light, int steps) {
  uint w, h;
  palette.GetDimensions(w, h);
  float3 c = linearToSrgb(albedoLinear);
  float best = 1e9;
  int2 at = int2(0, 0);
  for (int y = 0; y < int(h) && y < 16; y++) {
    for (int x = 0; x < int(w) && x < 16; x++) {
      float4 p = palette.Load(int3(x, y, 0));
      if (p.a < 0.5) continue;
      float3 d = linearToSrgb(p.rgb) - c;
      float dist = dot(d * d, float3(0.30, 0.59, 0.11));
      if (dist < best) {
        best = dist;
        at = int2(x, y);
      }
    }
  }
  int shift = int(round(saturate(light) * float(steps + 1))) - steps; // -steps (shadow) .. +1 (full light)
  int x = at.x;
  for (int k = 0; k < 16 && shift < 0 && x > 0 && palette.Load(int3(x - 1, at.y, 0)).a >= 0.5; k++, shift++) x--;
  for (int k = 0; k < 16 && shift > 0 && x + 1 < int(w) && palette.Load(int3(x + 1, at.y, 0)).a >= 0.5; k++, shift--) x++;
  return palette.Load(int3(x, at.y, 0)).rgb;
}

// ---------------------------------------------------------------- atmosphere
// Sky, sun, clouds, stars and distance haze, shared by the present pass (screen
// pixels, and the sky in every mode) and the probe post pass (world pixels).
// Must match Atmosphere in render/renderer.h.
struct Atmosphere {
  float4 skyTop;      // rgb: color overhead
  float4 skyBottom;   // rgb: color at the horizon
  float4 sunDir;      // xyz: towards the sun, w: cosine of the sun disc's radius
  float4 sunColor;    // rgb: sun light (linear, x intensity), w: glow strength
  float4 fog;         // rgb: haze color, w: density per world unit (0 = none)
  float4 clouds;      // x: coverage 0..1, y: scale, z: drift, w: stars 0..1
};

// PCG integer hash: bit-exact on every GPU (float hashes are not, because
// compilers may fuse their multiply-adds differently).
uint pcgHash(uint v) {
  uint state = v * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

// 0..1 for a lattice point (whole-number coordinates, so int2() is exact).
// Integer hash, 24 bits (exact in a float): the cloud noise built on it is
// the same on every GPU, so cloud edges do not flip palette colors across backends.
float hash12(float2 p) {
  int2 c = int2(p);
  return float(pcgHash(uint(c.x) + pcgHash(uint(c.y))) >> 8u) * (1.0 / 16777216.0);
}
float valueNoise(float2 p) {
  float2 i = floor(p), f = frac(p);
  float2 u = f * f * (3.0 - 2.0 * f);
  return lerp(lerp(hash12(i), hash12(i + float2(1, 0)), u.x), lerp(hash12(i + float2(0, 1)), hash12(i + float2(1, 1)), u.x), u.y);
}
float fbm(float2 p) {
  float v = 0.0, a = 0.5;
  for (int k = 0; k < 5; k++) {
    v += a * valueNoise(p);
    p = p * 2.03 + float2(17.1, 9.2);
    a *= 0.5;
  }
  return v;
}

// What the sky looks like in direction `dir` (unit length).
float3 skyRadiance(Atmosphere a, float3 dir) {
  float h = dir.y;
  // Most of the change happens near the horizon, where low cameras look.
  float3 sky = lerp(a.skyBottom.rgb, a.skyTop.rgb, saturate(sqrt(max(h, 0.0)) * 1.35));
  if (h < 0.0) sky = a.skyBottom.rgb * (1.0 + h * 0.6); // below the horizon: a little darker
  float s = dot(dir, a.sunDir.xyz);
  float3 sunTint = a.sunColor.rgb / max(max(a.sunColor.r, max(a.sunColor.g, a.sunColor.b)), 1e-3);
  // Stars where the sky is dark, fixed to directions so they turn with the sky.
  if (a.clouds.w > 0.0 && h > 0.0) {
    // Cells on a cube around the camera (400 x 400 per face, about the old
    // density): one division instead of atan2/asin, whose precision differs
    // between GPU compilers and moved stars between cells across backends.
    float3 ad = abs(dir);
    uint face = ad.x >= ad.y && ad.x >= ad.z ? (dir.x > 0.0 ? 0u : 1u) : (ad.y >= ad.z ? (dir.y > 0.0 ? 2u : 3u) : (dir.z > 0.0 ? 4u : 5u));
    float2 uv = face < 2u ? dir.zy / ad.x : (face < 4u ? dir.xz / ad.y : dir.xy / ad.z);
    uint2 cell = uint2(clamp((uv * 0.5 + 0.5) * 400.0, 0.0, 399.0));
    bool lit = (pcgHash(cell.x + cell.y * 400u + face * 160000u) & 0xFFFFu) < 164u; // 0.25% of cells
    float star = (lit ? 1.0 : 0.0) * a.clouds.w * saturate(1.0 - dot(sky, float3(0.3, 0.6, 0.1)) * 6.0);
    sky += star * float3(0.9, 0.9, 1.0);
  }
  // Sun: a disc and a soft glow around it.
  sky += sunTint * a.sunColor.w * (pow(saturate(s), 10.0) * 0.45 + pow(saturate(s), 120.0) * 0.8);
  if (s > a.sunDir.w) sky = lerp(sky, sunTint * 1.6 + 0.4, 0.9);
  // Clouds: noise on a ceiling, thick parts darker and cooler, the sun side warm.
  if (a.clouds.x > 0.0 && h > 0.0) {
    float2 uv = dir.xz / (h + 0.12) * a.clouds.y + float2(a.clouds.z, a.clouds.z * 0.37);
    float n = fbm(uv);
    float threshold = 1.0 - a.clouds.x;
    float cover = smoothstep(threshold, threshold + 0.12, n) * saturate(h * 6.0);
    float thick = smoothstep(threshold, 1.0, fbm(uv + float2(0.35, 0.2)));
    float3 lit = lerp(a.skyBottom.rgb, float3(1, 1, 1), 0.45) * lerp(float3(1, 1, 1), sunTint, 0.6) * (0.85 + 0.45 * saturate(s * 0.5 + 0.5));
    float3 shade = lerp(a.skyTop.rgb, a.skyBottom.rgb, 0.35) * float3(0.75, 0.7, 0.9);
    sky = lerp(sky, lerp(lit, shade, saturate(thick * 1.3)), cover);
  }
  return sky;
}

// Distance haze; brighter and warmer towards the sun.
float3 applyFog(Atmosphere a, float3 color, float dist, float3 dir) {
  if (a.fog.w <= 0.0) return color;
  float f = 1.0 - exp(-a.fog.w * dist);
  float3 sunTint = a.sunColor.rgb / max(max(a.sunColor.r, max(a.sunColor.g, a.sunColor.b)), 1e-3);
  float3 haze = a.fog.rgb + sunTint * a.sunColor.w * pow(saturate(dot(dir, a.sunDir.xyz)), 6.0) * 0.6;
  return lerp(color, haze, f);
}

// Views below this depth are "sky": no geometry was drawn there.
static const float kSkyDepth = 9000.0;
